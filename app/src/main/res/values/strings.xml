    <string name="enable_charging_hud">Hiện thông báo động khi cắm sạc (HUD)</string>
    <string name="charging_hud_desc">Hiển thị viên thuốc Dynamic Island nổi 5 giây khi vừa cắm sạc để báo nhanh thời gian sạc đầy và công suất.</string>
    <string name="enable_charging_notification">Hiện thông báo liên tục khi đang sạc</string>
    <string name="battery_protect_alert">Chuông báo khi sạc tới 80% (Bảo vệ pin)</string>
    <string name="battery_full_alert">Chuông báo khi sạc đầy 100%</string>
    <string name="battery_temp_alert">Cảnh báo khi nhiệt độ pin quá nóng (&gt; 42°C)</string>
    <string name="test_charging_hud">Xem thử giao diện sạc (Demo HUD)</string>

    <!-- Xiaomi Specific Optimization -->
    <string name="xiaomi_title">Cài Đặt Cần Thiết Cho Xiaomi / HyperOS</string>
    <string name="xiaomi_intro">Để các tính năng chạy ổn định không bị hệ thống tắt ngầm, vui lòng cấp các quyền sau:</string>
    
    <string name="perm_overlay_title">1. Quyền hiển thị trên ứng dụng khác</string>
    <string name="perm_overlay_desc">Bắt buộc để đồng hồ nổi và pop-up sạc pin có thể hiển thị đè lên màn hình.</string>
    <string name="btn_grant_overlay">Cấp quyền hiển thị nổi</string>

    <string name="perm_autostart_title">2. Quyền Tự khởi chạy (Autostart)</string>
    <string name="perm_autostart_desc">Cho phép ứng dụng tự chạy lại khi bạn khởi động lại máy điện thoại.</string>
    <string name="btn_grant_autostart">Mở cài đặt Tự khởi chạy</string>

    <string name="perm_battery_saver_title">3. Tiết kiệm pin: Không giới hạn</string>
    <string name="perm_battery_saver_desc">Chuyển sang "Không giới hạn" (No restrictions) để MIUI/HyperOS không kill app chạy nền.</string>
    <string name="btn_grant_battery_saver">Mở cài đặt Tiết kiệm pin</string>

    <string name="perm_lockscreen_title">4. Hiển thị trên màn hình khóa</string>
    <string name="perm_lockscreen_desc">Cho phép xem giờ và thông số pin ngay cả khi màn hình đang khóa.</string>
    <string name="btn_grant_lockscreen">Cài đặt quyền màn hình khóa</string>

    <string name="shortcut_battery_info">Mở trang thông tin pin ẩn của Xiaomi</string>

