    <!-- Battery & Charging Section -->
    <string name="battery_title">Ước Lượng Sạc &amp; Thông Số Pin</string>
    <string name="battery_desc">Tự động tính toán thời gian sạc đầy, đo công suất sạc W và theo dõi nhiệt độ bảo vệ pin.</string>
    <string name="battery_status_charging">Đang sạc</string>
    <string name="battery_status_discharging">Đang dùng pin</string>
    <string name="battery_status_full">Pin đã đầy</string>
    <string name="battery_status_not_charging">Không sạc</string>

    <string name="charging_eta_title">Thời gian dự kiến sạc đầy</string>
    <string name="charging_power_title">Công suất sạc</string>
    <string name="battery_temp_title">Nhiệt độ pin</string>
    <string name="battery_voltage_title">Điện áp</string>
