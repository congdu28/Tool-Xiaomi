<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_drag_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📶 Mở Khóa VoLTE &amp; VoWiFi"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Tự động vô hiệu hóa kiểm tra nhà mạng (Carrier Check) trên ROM nội địa / xách tay, khắc phục lỗi mất sóng, nghẽn cuộc gọi trên mạng 4G/LTE."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bs_btn_unlock_volte"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:backgroundTint="@color/card_highlight"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="📶 Mở khóa VoLTE\n(*#*#86583#*#*)"
            android:textColor="@color/neon_green"
            android:textSize="12sp"
            app:cornerRadius="8dp"
            app:strokeColor="@color/neon_green"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bs_btn_unlock_vowifi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:backgroundTint="@color/card_highlight"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="🌐 Mở khóa VoWiFi\n(*#*#869434#*#*)"
            android:textColor="@color/neon_cyan"
            android:textSize="12sp"
            app:cornerRadius="8dp"
            app:strokeColor="@color/neon_cyan"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bs_btn_open_radio_testing"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:backgroundTint="@color/card_highlight"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="📡 Kiểm tra sóng Radio\n(*#*#4636#*#*)"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bs_btn_open_sim_settings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:backgroundTint="@color/card_highlight"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="⚙️ Cài đặt Mạng SIM\n(Bật VoLTE switch)"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            app:cornerRadius="8dp" />
    </LinearLayout>

</LinearLayout>
