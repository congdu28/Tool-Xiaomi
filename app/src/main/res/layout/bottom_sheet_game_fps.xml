<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_bottom_sheet" android:orientation="vertical" android:paddingTop="12dp">
    <View android:layout_width="40dp" android:layout_height="4dp" android:layout_gravity="center_horizontal" android:layout_marginBottom="12dp" android:background="@drawable/bg_drag_handle" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="20dp" android:paddingEnd="20dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/feature_gaming" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />
        <com.google.android.material.button.MaterialButton android:id="@+id/sheet_close" style="@style/Widget.MiTool.Button.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@string/action_close" android:minHeight="48dp" android:text="@string/action_close" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@android:color/transparent" android:fillViewport="true" android:overScrollMode="never">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="24dp">

            <!-- Status Strip -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card_rounded" android:orientation="vertical" android:padding="12dp">
                <LinearLayout android:id="@+id/bs_layout_shizuku_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/bs_tv_shizuku_status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:singleLine="true" android:text="@string/copy_bottom_sheet_game_fps_bs_tv_shizuk_d443811" android:textColor="@color/neon_green" android:textSize="12sp" android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/bs_btn_shizuku_action" style="@style/Widget.MiTool.Button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingLeft="10dp" android:paddingRight="10dp" android:text="@string/copy_bottom_sheet_game_fps_bs_btn_shizu_a973201" android:textStyle="bold" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:background="@color/card_dark_stroke" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/bs_tv_joyose_status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:singleLine="true" android:text="@string/copy_bottom_sheet_game_fps_bs_tv_joyose_90a8c51" android:textColor="@color/neon_cyan" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:id="@+id/bs_tv_screen_hz_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:singleLine="true" android:text="@string/copy_bottom_sheet_game_fps_bs_tv_screen_58df566" android:textColor="@color/neon_green" android:textSize="12sp" />
                </LinearLayout>
                <TextView android:id="@+id/bs_tv_thermal_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/game_thermal_status_loading" android:textColor="@color/text_secondary" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>

            <!-- Hero Card: Thermal-Safe Optimization -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_card_rounded" android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/game_thermal_card_title" android:textColor="@color/neon_green" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/game_thermal_card_desc" android:textColor="@color/text_secondary" android:textSize="12sp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@color/card_highlight" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingTop="4dp" android:paddingEnd="6dp" android:paddingBottom="4dp">
                    <TextView android:id="@+id/bs_tv_thermal_target_game" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/bs_btn_pick_thermal_game" style="@style/Widget.MiTool.Button.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/game_thermal_pick_game" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/bs_btn_preset_cool_60" style="@style/Widget.MiTool.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_weight="1" android:minHeight="52dp" android:paddingLeft="6dp" android:paddingRight="6dp" android:text="@string/game_thermal_preset_cool_60" android:textSize="12sp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/bs_btn_preset_balanced_90" style="@style/Widget.MiTool.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:layout_weight="1" android:minHeight="52dp" android:paddingLeft="6dp" android:paddingRight="6dp" android:text="@string/game_thermal_preset_balanced_90" android:textSize="12sp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/bs_btn_preset_custom" style="@style/Widget.MiTool.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_weight="0.9" android:minHeight="52dp" android:paddingLeft="6dp" android:paddingRight="6dp" android:text="@string/game_thermal_preset_custom" android:textSize="12sp" />
                </LinearLayout>

                <TextView android:id="@+id/bs_tv_thermal_config_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/neon_cyan" android:textSize="12sp" android:textStyle="bold" />

                <LinearLayout android:id="@+id/bs_layout_thermal_custom" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@color/card_highlight" android:orientation="vertical" android:padding="10dp" android:visibility="gone">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton android:id="@+id/bs_btn_thermal_fps" style="@style/Widget.MiTool.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_weight="1" android:minHeight="48dp" android:paddingLeft="6dp" android:paddingRight="6dp" android:textSize="12sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/bs_btn_thermal_scale" style="@style/Widget.MiTool.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_weight="1" android:minHeight="48dp" android:paddingLeft="6dp" android:paddingRight="6dp" android:textSize="12sp" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/bs_btn_thermal_mode" style="@style/Widget.MiTool.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:minHeight="48dp" android:textSize="12sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/game_thermal_opt_align_hz" android:textColor="@color/text_primary" android:textSize="12sp" />
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/bs_switch_thermal_align_hz" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/game_thermal_opt_precompile" android:textColor="@color/text_primary" android:textSize="12sp" />
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/bs_switch_thermal_precompile" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/game_thermal_opt_trim_bg" android:textColor="@color/text_primary" android:textSize="12sp" />
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/bs_switch_thermal_trim_bg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton android:id="@+id/bs_btn_apply_and_launch_game" style="@style/Widget.MiTool.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:minHeight="48dp" android:text="@string/game_thermal_btn_apply_launch" android:textStyle="bold" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/bs_btn_apply_thermal_opt" style="@style/Widget.MiTool.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_weight="1" android:minHeight="48dp" android:paddingLeft="6dp" android:paddingRight="6dp" android:text="@string/game_thermal_btn_apply" android:textSize="12sp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/bs_btn_restore_thermal_opt" style="@style/Widget.MiTool.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_weight="1" android:minHeight="48dp" android:paddingLeft="6dp" android:paddingRight="6dp" android:text="@string/game_thermal_btn_restore" android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton android:id="@+id/bs_btn_open_ram_from_game" style="@style/Widget.MiTool.Button.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:minHeight="48dp" android:text="@string/game_thermal_btn_ram_cleaner" />

                <LinearLayout android:id="@+id/bs_layout_thermal_result" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/bg_badge_green" android:orientation="vertical" android:padding="10dp">
                    <TextView android:id="@+id/bs_tv_thermal_result_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_thermal_result_default_title" android:textColor="@color/neon_green" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:id="@+id/bs_tv_thermal_result_desc" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/game_thermal_result_default_desc" android:textColor="@color/text_secondary" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card 2: Floating Game HUD (Customization collapsed by default) -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_card_rounded" android:orientation="vertical" android:padding="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:importantForAccessibility="no" android:src="@drawable/ic_gamepad" app:tint="@color/neon_green" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/game_hud_title" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/bs_switch_game_hud" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/copy_bottom_sheet_game_fps_text_c8c7460" android:textColor="@color/text_secondary" android:textSize="12sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/bs_btn_add_hud_qs_tile" style="@style/Widget.MiTool.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:text="@string/copy_bottom_sheet_game_fps_bs_btn_add_h_ce54d09" android:textSize="12sp" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/bs_btn_toggle_hud_custom" style="@style/Widget.MiTool.Button.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:minHeight="48dp" android:text="@string/game_thermal_hud_customize_show" />

                <LinearLayout android:id="@+id/bs_layout_hud_customization" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@color/card_highlight" android:orientation="vertical" android:padding="12dp" android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/copy_bottom_sheet_game_fps_text_8b9078c" android:textColor="@color/neon_cyan" android:textSize="13sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/copy_bottom_sheet_game_fps_text_9c9846c" android:textColor="@color/text_primary" android:textSize="12sp" />
                        <TextView android:id="@+id/bs_tv_hud_scale_val" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/copy_bottom_sheet_game_fps_bs_tv_hud_sc_77c6cd9" android:textColor="@color/neon_green" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>
                    <SeekBar android:id="@+id/bs_sb_hud_scale" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:max="70" android:progress="30" android:progressTint="@color/neon_green" android:thumbTint="@color/neon_green" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton android:id="@+id/bs_btn_scale_small" style="@style/Widget.MiTool.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_weight="1" android:minHeight="48dp" android:padding="0dp" android:text="@string/copy_bottom_sheet_game_fps_bs_btn_scale_e001036" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/bs_btn_scale_standard" style="@style/Widget.MiTool.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:layout_weight="1" android:minHeight="48dp" android:padding="0dp" android:text="@string/copy_bottom_sheet_game_fps_bs_btn_scale_ea1974d" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/bs_btn_scale_large" style="@style/Widget.MiTool.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_weight="1" android:minHeight="48dp" android:padding="0dp" android:text="@string/copy_bottom_sheet_game_fps_bs_btn_scale_eaf8ffa" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/copy_bottom_sheet_game_fps_text_e2facd4" android:textColor="@color/text_primary" android:textSize="12sp" />
                        <TextView android:id="@+id/bs_tv_hud_bg_opacity_val" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/copy_bottom_sheet_game_fps_bs_tv_hud_bg_854972f" android:textColor="@color/neon_cyan" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>
                    <SeekBar android:id="@+id/bs_sb_hud_bg_opacity" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:max="100" android:progress="85" android:progressTint="@color/neon_cyan" android:thumbTint="@color/neon_cyan" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton android:id="@+id/bs_btn_bg_transparent" style="@style/Widget.MiTool.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="3dp" android:layout_weight="1" android:minHeight="48dp" android:padding="0dp" android:text="@string/copy_bottom_sheet_game_fps_bs_btn_bg_tr_9b62083" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/bs_btn_bg_glass" style="@style/Widget.MiTool.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:layout_weight="1" android:minHeight="48dp" android:padding="0dp" android:text="@string/copy_bottom_sheet_game_fps_bs_btn_bg_gl_a168851" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/bs_btn_bg_dark" style="@style/Widget.MiTool.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:layout_weight="1" android:minHeight="48dp" android:padding="0dp" android:text="@string/copy_bottom_sheet_game_fps_bs_btn_bg_da_7bba9fd" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/copy_bottom_sheet_game_fps_text_9903602" android:textColor="@color/text_primary" android:textSize="12sp" />
                        <TextView android:id="@+id/bs_tv_hud_text_opacity_val" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/copy_bottom_sheet_game_fps_bs_tv_hud_te_ce055f4" android:textColor="@color/mi_orange" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>
                    <SeekBar android:id="@+id/bs_sb_hud_text_opacity" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:max="70" android:progress="70" android:progressTint="@color/mi_orange" android:thumbTint="@color/mi_orange" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton android:id="@+id/bs_btn_text_dim" style="@style/Widget.MiTool.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_weight="1" android:minHeight="48dp" android:padding="0dp" android:text="@string/copy_bottom_sheet_game_fps_bs_btn_text_70f7dbb" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/bs_btn_text_bright" style="@style/Widget.MiTool.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_weight="1" android:minHeight="48dp" android:padding="0dp" android:text="@string/copy_bottom_sheet_game_fps_bs_btn_text_e2ec99b" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/copy_bottom_sheet_game_fps_text_9b8cfbb" android:textColor="@color/neon_cyan" android:textSize="13sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/copy_bottom_sheet_game_fps_text_0295dd0" android:textColor="@color/text_primary" android:textSize="12sp" />
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/bs_switch_hud_fps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/copy_bottom_sheet_game_fps_text_b347925" android:textColor="@color/text_primary" android:textSize="12sp" />
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/bs_switch_hud_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/copy_bottom_sheet_game_fps_text_545829b" android:textColor="@color/text_primary" android:textSize="12sp" />
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/bs_switch_hud_cpu" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/copy_bottom_sheet_game_fps_text_30ab2f2" android:textColor="@color/text_primary" android:textSize="12sp" />
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/bs_switch_hud_ram" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/copy_bottom_sheet_game_fps_text_561ea51" android:textColor="@color/text_primary" android:textSize="12sp" />
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/bs_switch_hud_power" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Card 3: Game Library -->
