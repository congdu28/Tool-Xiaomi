<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Drag Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_drag_handle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎮 Mở Khóa 120 FPS Game &amp; Joyose"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Vô hiệu hóa tiến trình Joyose ngầm của HyperOS/MIUI để gỡ bỏ triệt để giới hạn khóa 89 FPS trong Liên Quân, Tốc Chiến, PUBG."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Joyose Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@color/card_highlight"
            android:gravity="center_vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/bs_tv_joyose_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Joyose: Đang kiểm tra..."
                android:textColor="@color/neon_cyan"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bs_btn_game_120_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="44dp"
            android:backgroundTint="@color/mi_orange"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="⚡ 1-Chạm Kích Hoạt Game Mode 120Hz"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bs_btn_copy_disable_joyose"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:minHeight="42dp"
                android:minWidth="0dp"
                android:backgroundTint="@color/card_highlight"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="⚡ Tắt Joyose (Shizuku)"
                android:textColor="@color/neon_green"
                android:textSize="11sp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/neon_green"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bs_btn_copy_enable_joyose"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:minHeight="42dp"
                android:minWidth="0dp"
                android:backgroundTint="@color/card_highlight"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="🔄 Bật lại Joyose"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bs_btn_clear_powerkeeper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="44dp"
            android:backgroundTint="@color/card_highlight"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="🗑️ Xóa cache Pin &amp; Hiệu suất (PowerKeeper)"
            android:textColor="@color/neon_cyan"
            android:textSize="12sp"
            app:cornerRadius="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bs_btn_open_per_app_hz"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:minHeight="42dp"
                android:minWidth="0dp"
                android:backgroundTint="@color/card_highlight"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="🎯 Chọn app 120Hz"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bs_btn_launch_aov"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:minHeight="42dp"
                android:minWidth="0dp"
                android:backgroundTint="@color/card_highlight"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="⚔️ Mở Liên Quân"
                android:textColor="@color/neon_cyan"
                android:textSize="11sp"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- Mini Game HUD (FPS & Performance Monitor) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_gamepad"
                    app:tint="@color/neon_green" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Mini Game HUD Nổi (FPS &amp; Hiệu Năng)"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/bs_switch_game_hud"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Hiển thị thanh nổi thời gian thực đo FPS, CPU, RAM và nhiệt độ máy khi chơi game. Chạm để mở rộng hoặc thu nhỏ."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bs_btn_toggle_game_hud"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:minHeight="40dp"
                    android:minWidth="0dp"
                    android:backgroundTint="@color/card_highlight"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:text="🎮 Bật / Tắt HUD"
                    android:textColor="@color/neon_green"
                    android:textSize="11sp"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bs_btn_add_hud_qs_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:minHeight="40dp"
                    android:minWidth="0dp"
                    android:backgroundTint="@color/card_highlight"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:text="🎛️ Thêm vào Quick Settings"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <!-- Tùy chỉnh HUD (Kích thước, Độ mờ, Thông số) -->
            <LinearLayout
                android:id="@+id/bs_layout_hud_customization"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎨 Tùy Chỉnh Kích Thước &amp; Độ Mờ"
                    android:textColor="@color/neon_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- 1. Kích thước (Scale) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Kích thước HUD:"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/bs_tv_hud_scale_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100% (Chuẩn)"
                        android:textColor="@color/neon_green"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/bs_sb_hud_scale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="70"
                    android:progress="30"
                    android:progressTint="@color/neon_green"
                    android:thumbTint="@color/neon_green" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bs_btn_scale_small"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/card_highlight"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="Nhỏ (80%)"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        app:cornerRadius="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bs_btn_scale_standard"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/card_highlight"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="Chuẩn (100%)"
                        android:textColor="@color/neon_green"
                        android:textSize="10sp"
                        app:cornerRadius="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bs_btn_scale_large"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/card_highlight"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="Lớn (120%)"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        app:cornerRadius="6dp" />
                </LinearLayout>

                <!-- 2. Độ trong suốt NỀN HUD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Độ mờ Nền HUD (Capsule):"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/bs_tv_hud_bg_opacity_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="85% (Kính mờ)"
                        android:textColor="@color/neon_cyan"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/bs_sb_hud_bg_opacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="100"
                    android:progress="85"
                    android:progressTint="@color/neon_cyan"
                    android:thumbTint="@color/neon_cyan" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bs_btn_bg_transparent"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/card_highlight"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="Không nền (0%)"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        app:cornerRadius="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bs_btn_bg_glass"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/card_highlight"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="Kính mờ (50%)"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        app:cornerRadius="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bs_btn_bg_dark"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="3dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/card_highlight"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="Đậm (85%)"
                        android:textColor="@color/neon_cyan"
                        android:textSize="10sp"
                        app:cornerRadius="6dp" />
                </LinearLayout>

                <!-- 3. Độ rõ / mờ CHỮ HUD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Độ rõ Chữ &amp; Biểu tượng:"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/bs_tv_hud_text_opacity_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100% (Sắc nét)"
                        android:textColor="@color/mi_orange"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/bs_sb_hud_text_opacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="70"
                    android:progress="70"
                    android:progressTint="@color/mi_orange"
                    android:thumbTint="@color/mi_orange" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bs_btn_text_dim"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/card_highlight"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="Mờ nhẹ (65%)"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        app:cornerRadius="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bs_btn_text_bright"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/card_highlight"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="Rõ nét (100%)"
                        android:textColor="@color/mi_orange"
                        android:textSize="10sp"
                        app:cornerRadius="6dp" />
                </LinearLayout>

                <!-- 3. Các thông số hiển thị -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="📊 Thông Số Hiển Thị Trên HUD"
                    android:textColor="@color/neon_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⚡ FPS thời gian thực"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/bs_switch_hud_fps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🌡️ Nhiệt độ máy &amp; Pin (°C)"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/bs_switch_hud_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💻 Tải CPU (%)"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/bs_switch_hud_cpu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🧠 Dung lượng RAM (%)"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/bs_switch_hud_ram"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🔋 Công suất xả/sạc pin (Watt)"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/bs_switch_hud_power"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Thư Viện Tựa Game Của Bạn -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_gamepad"
                    app:tint="@color/neon_green" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="🎮 Thư Viện Game Của Bạn"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bs_btn_add_custom_game"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:backgroundTint="@color/card_highlight"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="➕ Thêm Game"
                    android:textColor="@color/neon_green"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/neon_green"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Bấm &quot;⚔️ Chơi Ngay&quot; để tự động bật HUD nổi FPS và mở game chỉ với 1 chạm. Bấm &quot;➕ Thêm Game&quot; để tùy ý thêm bất kỳ tựa game hay ứng dụng nào của bạn."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Dynamic Game Items Container -->
            <LinearLayout
                android:id="@+id/bs_layout_game_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <!-- Empty state when no games added -->
            <TextView
                android:id="@+id/bs_tv_no_games"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:gravity="center"
                android:text="Chưa có game nào trong danh sách.\nBấm &quot;➕ Thêm Game&quot; để thêm trò chơi yêu thích của bạn!"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>

</androidx.core.widget.NestedScrollView>
