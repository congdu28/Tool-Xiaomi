                        <TextView android:id="@+id/bs_tv_alert_level_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:text="@string/copy_bottom_sheet_battery_alert_bs_tv_a_5366a74" android:textColor="@color/neon_green" android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>
                    <SeekBar android:id="@+id/bs_sb_battery_alert_level" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:max="45" android:progress="30" android:progressTint="@color/neon_green" android:thumbTint="@color/neon_green" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@color/card_highlight" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/copy_bottom_sheet_battery_alert_text_9dda26d" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/bs_tv_selected_audio_tone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:text="@string/battery_alert_tone_default" android:textColor="@color/neon_cyan" android:textSize="12sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/bs_btn_pick_audio" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="3dp" android:layout_weight="1" android:paddingLeft="2dp" android:paddingRight="2dp" android:text="@string/copy_bottom_sheet_battery_alert_bs_btn_7d17faa" style="@style/Widget.MiTool.Button" android:minHeight="48dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/bs_btn_test_audio" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:layout_weight="1" android:paddingLeft="2dp" android:paddingRight="2dp" android:text="@string/btn_test_audio" style="@style/Widget.MiTool.Button" android:minHeight="48dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/bs_btn_reset_audio" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:layout_weight="1" android:paddingLeft="2dp" android:paddingRight="2dp" android:text="@string/btn_reset_audio" style="@style/Widget.MiTool.Button" android:minHeight="48dp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:layout_weight="1" android:text="@string/copy_bottom_sheet_battery_alert_text_93d206c" android:textColor="@color/text_primary" android:textSize="12sp" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/bs_switch_lockscreen_ambient" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:layout_weight="1" android:text="@string/copy_bottom_sheet_battery_alert_text_27eabb7" android:textColor="@color/text_primary" android:textSize="12sp" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/bs_switch_alert_100" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:layout_weight="1" android:text="@string/copy_bottom_sheet_battery_alert_text_f836185" android:textColor="@color/text_primary" android:textSize="12sp" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/bs_switch_alert_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/bs_btn_view_sot_stats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:paddingLeft="8dp" android:paddingRight="8dp" android:text="@string/copy_bottom_sheet_battery_alert_bs_btn_79aa7ff" style="@style/Widget.MiTool.Button" android:minHeight="48dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>