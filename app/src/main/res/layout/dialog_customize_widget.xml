        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_widget_save" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/copy_dialog_customize_widget_btn_widget_bb38780" style="@style/Widget.MiTool.Button" android:minHeight="48dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_widget_close" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/action_close" style="@style/Widget.MiTool.Button" android:minHeight="48dp" />
        </LinearLayout>
