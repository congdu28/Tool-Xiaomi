        <RadioGroup android:id="@+id/rg_widget_style" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
            <RadioButton android:id="@+id/rb_style_dashboard" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="@string/copy_dialog_customize_widget_rb_style_d_17177ba" android:textColor="@color/text_primary" android:textSize="12sp" android:minHeight="48dp" />
            <RadioButton android:id="@+id/rb_style_hyperos" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/copy_dialog_customize_widget_rb_style_h_da611a9" android:textColor="@color/text_primary" android:textSize="12sp" android:minHeight="48dp" />
            <RadioButton android:id="@+id/rb_style_minimal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/copy_dialog_customize_widget_rb_style_m_7af3bb9" android:textColor="@color/text_primary" android:textSize="12sp" android:minHeight="48dp" />
        </RadioGroup>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:layout_marginBottom="10dp" android:background="@color/card_dark_stroke" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/copy_dialog_customize_widget_text_33b12ab" android:textColor="@color/neon_yellow" android:textSize="13sp" android:textStyle="bold" />
        <RadioGroup android:id="@+id/rg_widget_theme" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
            <RadioButton android:id="@+id/rb_theme_system" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/copy_dialog_customize_widget_rb_theme_s_f909bb7" android:textColor="@color/text_primary" android:textSize="12sp" android:minHeight="48dp" />
            <RadioButton android:id="@+id/rb_theme_dark" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/copy_dialog_customize_widget_rb_theme_d_b435259" android:textColor="@color/text_primary" android:textSize="12sp" android:minHeight="48dp" />
            <RadioButton android:id="@+id/rb_theme_light" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/copy_dialog_customize_widget_rb_theme_l_56e16da" android:textColor="@color/text_primary" android:textSize="12sp" android:minHeight="48dp" />
        </RadioGroup>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:layout_marginBottom="10dp" android:background="@color/card_dark_stroke" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/copy_dialog_customize_widget_text_c97080d" android:textColor="@color/neon_green" android:textSize="13sp" android:textStyle="bold" />
        <RadioGroup android:id="@+id/rg_widget_interval" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
            <RadioButton android:id="@+id/rb_interval_15" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/copy_dialog_customize_widget_rb_interva_0ecfc9d" android:textColor="@color/text_primary" android:textSize="12sp" android:minHeight="48dp" />
            <RadioButton android:id="@+id/rb_interval_30" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/copy_dialog_customize_widget_rb_interva_cb612b8" android:textColor="@color/text_primary" android:textSize="12sp" android:minHeight="48dp" />
            <RadioButton android:id="@+id/rb_interval_60" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/copy_dialog_customize_widget_rb_interva_5d0a8e8" android:textColor="@color/text_primary" android:textSize="12sp" android:minHeight="48dp" />
