<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Drag Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_drag_handle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ Tần Số Quét Màn Hình (Hz)"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ép màn hình chạy ở tần số quét cố định toàn hệ thống, hoặc để Tự động (Auto) cho hệ thống tự điều tiết."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Current active rate & mode display -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@color/card_highlight"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tần số quét đang hoạt động:"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/bs_tv_current_hz"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="120 Hz"
                    android:textColor="@color/neon_green"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/bs_tv_hz_current_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Chế độ đã chọn: Tự động (Auto)"
                android:textColor="@color/neon_cyan"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="💡 Ở chế độ Tự động, Xiaomi tự tăng lên 120Hz khi vuốt chạm và giảm khi đứng yên để tiết kiệm pin."
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Buttons row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bs_btn_hz_auto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:minHeight="42dp"
                android:minWidth="0dp"
                android:backgroundTint="@color/card_highlight"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Auto"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bs_btn_hz_60"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:minHeight="42dp"
                android:minWidth="0dp"
                android:backgroundTint="@color/card_highlight"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="60 Hz"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bs_btn_hz_90"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:minHeight="42dp"
                android:minWidth="0dp"
                android:backgroundTint="@color/card_highlight"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="90 Hz"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- Buttons row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bs_btn_hz_120"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:minHeight="42dp"
                android:minWidth="0dp"
                android:backgroundTint="@color/card_highlight"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="120 Hz"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bs_btn_hz_144"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:minHeight="42dp"
                android:minWidth="0dp"
                android:backgroundTint="@color/card_highlight"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="144 Hz"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bs_btn_hz_custom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:minHeight="42dp"
                android:minWidth="0dp"
                android:backgroundTint="@color/card_highlight"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="✏️ Tùy chỉnh"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bs_btn_add_hz_tile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="44dp"
            android:backgroundTint="@color/card_highlight"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:maxLines="2"
            android:text="🎛️ Thêm phím Tần số quét vào Trung tâm điều khiển"
            android:textColor="@color/neon_green"
            android:textSize="11.5sp"
            app:cornerRadius="8dp"
            app:strokeColor="@color/neon_green"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bs_btn_open_hz_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="44dp"
            android:backgroundTint="@color/card_highlight"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="⚙️ Mở Cài đặt Màn hình hệ thống"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            app:cornerRadius="8dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
