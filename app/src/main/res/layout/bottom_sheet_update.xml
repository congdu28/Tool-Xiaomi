<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_bottom_sheet" android:fillViewport="true" android:overScrollMode="never">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <View android:layout_width="40dp" android:layout_height="4dp" android:layout_gravity="center_horizontal" android:layout_marginBottom="16dp" android:background="@drawable/bg_drag_handle" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <FrameLayout android:id="@+id/bs_update_icon_container" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_circle_icon" android:backgroundTint="#26FF6700">
                <TextView android:id="@+id/bs_update_icon_emoji" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/copy_bottom_sheet_game_fps_text_b858cb2" android:textSize="22sp" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/bs_update_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/copy_activity_main_text_089f3b1" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />
                <TextView android:id="@+id/bs_update_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/copy_bottom_sheet_update_bs_update_subt_d8cb4d2" android:textColor="@color/text_secondary" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:id="@+id/bs_update_tag_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_badge_rounded" android:paddingStart="8dp" android:paddingTop="3dp" android:paddingEnd="8dp" android:paddingBottom="3dp" android:text="@string/copy_bottom_sheet_update_bs_update_tag_ba69b5b" android:textColor="@color/neon_green" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/bs_update_version_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@color/card_highlight" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/copy_bottom_sheet_update_text_c61e524" android:textColor="@color/text_muted" android:textSize="12sp" />
                <TextView android:id="@+id/bs_update_current_ver" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="monospace" android:text="@string/copy_bottom_sheet_update_bs_update_curr_768e6e3" android:textColor="@color/text_secondary" android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/bs_update_arrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:text="@string/copy_bottom_sheet_game_fps_text_b858cb2" android:textColor="@color/mi_orange" android:textSize="16sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/bs_update_new_ver_container" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/copy_bottom_sheet_update_text_3e11984" android:textColor="@color/text_muted" android:textSize="12sp" />
                <TextView android:id="@+id/bs_update_new_ver" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="monospace" android:text="@string/copy_activity_main_tv_settings_current_e0ba675" android:textColor="@color/neon_green" android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/bs_update_changelog_header" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/copy_bottom_sheet_update_bs_update_chan_4d289b3" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
        <androidx.core.widget.NestedScrollView android:id="@+id/bs_update_changelog_scroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/bg_card_rounded" android:maxHeight="180dp" android:overScrollMode="never" android:padding="12dp">
            <TextView android:id="@+id/bs_update_changelog" android:layout_width="match_parent" android:layout_height="wrap_content" android:lineSpacingExtra="3dp" android:text="@string/copy_bottom_sheet_update_bs_update_chan_5354ac5" android:textColor="@color/text_secondary" android:textSize="12sp" />
        </androidx.core.widget.NestedScrollView>
        <com.google.android.material.button.MaterialButton android:id="@+id/bs_update_btn_action" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:paddingLeft="8dp" android:paddingRight="8dp" android:text="@string/copy_bottom_sheet_update_bs_update_btn_dc79ed1" android:textStyle="bold" style="@style/Widget.MiTool.Button" android:minHeight="48dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/bs_update_btn_dismiss" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:paddingLeft="8dp" android:paddingRight="8dp" android:text="@string/action_close" style="@style/Widget.MiTool.Button" android:minHeight="48dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>